{
	"name": "iw3sr",
	"version": "1.8.2",
	"description": "A Call of Duty 4 client modification.",
	"homepage": "https://github.com/Iswenzz/IW3SR",
	"features": {
		"windows": {
			"description": "Build Windows",
			"dependencies": [
				{ "name": "imgui", "features": ["win32-binding"] }
			]
		},
		"dx9": {
			"description": "Build DX9",
			"dependencies": [
				{ "name": "imgui", "features": ["dx9-binding"] },
				"directxsdk"
			]
		},
		"cef": {
			"description": "Build CEF",
			"dependencies": ["cef"]
		}
	},
	"dependencies": [
		{ "name": "curl", "features": ["non-http", "openssl", "ssh"], "default-features": false },
		"glm",
		{ "name": "imgui", "features": ["club", "markdown"] },
		"implot",
		"libsamplerate",
		"libzippp",
		"nlohmann-json",
		"opus",
		"polyhook2",
		"sentry-native",
		"speex"
	],
	"overrides": [
		{ "name": "cef", "version": "149.0.6" },
		{ "name": "curl", "version": "8.14.1" },
        { "name": "directxsdk", "version-string": "jun10#8" },
		{ "name": "glm", "version": "1.0.1#2" },
        { "name": "imgui", "version": "1.92.8" },
        { "name": "implot", "version": "0.16#1" },
		{ "name": "libsamplerate", "version": "0.2.2#1" },
		{ "name": "libzippp", "version": "7.1-1.10.1"},
        { "name": "nlohmann-json", "version": "3.11.3" },
		{ "name": "opus", "version": "1.5.2#1" },
        { "name": "polyhook2", "version": "2024-02-08" },
        { "name": "sentry-native", "version": "0.12.1" },
		{ "name": "speex", "version": "1.2.1#1" }
    ]
}
